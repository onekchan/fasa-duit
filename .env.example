# Copy to .env.local and fill in with your Supabase project values.
# Never commit .env.local — it's gitignored.

# ── Supabase (server + client) ────────────────────────────────────────────────
# Get these from: https://app.supabase.com/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only. NEVER expose to the client. Only import from server actions,
# route handlers, or scripts. Used for admin tasks (e.g. seeding, migrations run
# outside of the Supabase CLI).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── App ───────────────────────────────────────────────────────────────────────
# Set to your production URL when deploying (used for auth email redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Ads (optional, Phase 1 Beta monetization) ─────────────────────────────────
# Flip these ONLY on production after EthicalAds approves the publisher account.
# Preview + dev deployments should leave these unset so no ad script loads.
# NEXT_PUBLIC_ADS_ENABLED=1
# NEXT_PUBLIC_ETHICALADS_PUBLISHER=fasa-duit
